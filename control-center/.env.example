# Copy to .env (compose reads it automatically) and adjust. Nothing here is a production
# secret; the migrator/app/audit/ro passwords are separate so that the privilege split is
# visible even in dev.

CC_PG_BASE=postgres:17-bookworm
CC_PG_PORT=55432
CC_MGMT_PORT=8081
CC_CONTROL_PORT=8082
CC_WEB_PORT=8080

CC_VERSION=0.1.0-dev
CC_PG_SUPERUSER_PASSWORD=postgres
CC_MIGRATOR_PASSWORD=cc_migrator
CC_APP_PASSWORD=cc_app
CC_AUDIT_PASSWORD=cc_audit
CC_RO_PASSWORD=cc_ro

CC_NODE_IMAGE=node:22-alpine
CC_NGINX_IMAGE=nginx:1.27-alpine
