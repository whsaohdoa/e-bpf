# Template for the per-machine settings of Dockerfile / docker-compose.yml.
#
# Copy it to .env in the same directory and edit the copy:
#
#   cp .env.template .env
#
# Compose loads .env automatically and interpolates the ${VAR} references in
# docker-compose.yml from it; the build args below are forwarded to the
# Dockerfile ARGs of the same name. .env is git-ignored, this template is
# tracked. Keep the values here equal to the defaults baked into Dockerfile /
# docker-compose.yml so the template stays the single documented source.
#
# Syntax note: plain KEY=VALUE, no `export`, no quoting unless a value contains
# spaces. Do not append a trailing slash to any URL.

# ---------------------------------------------------------------------------
# Base image / build
# ---------------------------------------------------------------------------
AYA_DEV_BUILD_CONTEXT=.
AYA_DEV_DOCKERFILE=Dockerfile

# ---------------------------------------------------------------------------
# Package and toolchain mirrors (network-location specific)
#
# Defaults are the upstream public endpoints. A machine behind the GFW
# typically uses the Tsinghua (TUNA) mirrors, which mirror the Ubuntu archive,
# apt.llvm.org and the Rust distribution:
#
#   UBUNTU_BOOTSTRAP_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu
#   UBUNTU_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
#   LLVM_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/llvm-apt
#   RUSTUP_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/rustup
#
# UBUNTU_BOOTSTRAP_MIRROR must be plain HTTP: it is used before ca-certificates
# are installed. UBUNTU_MIRROR (HTTPS) replaces it immediately afterwards.
# LLVM_GPG_KEY_URL stays on apt.llvm.org because mirrors usually serve
# packages only, not the signing key. If a mirror lags behind upstream, point
# LLVM_MIRROR at https://apt.llvm.org.
# ---------------------------------------------------------------------------
UBUNTU_BOOTSTRAP_MIRROR=http://archive.ubuntu.com/ubuntu
UBUNTU_MIRROR=https://archive.ubuntu.com/ubuntu
LLVM_MIRROR=https://apt.llvm.org
LLVM_GPG_KEY_URL=https://apt.llvm.org/llvm-snapshot.gpg.key
RUSTUP_MIRROR=https://static.rust-lang.org

# Git's global http.version inside the image. HTTP/1.1 is a workaround for
# "tls handshake eof" resets on GitHub's smart-HTTP endpoint when gitoxide
# negotiates HTTP/2; use HTTP/2 on a network where that does not happen.
# Must not be empty: an empty value makes `git config` fail and break the build.
GIT_HTTP_VERSION=HTTP/1.1

# ---------------------------------------------------------------------------
# Image and container identity
#
# Container names must be unique per Docker daemon, so give each checkout (or
# machine) its own AYA_DEV_CONTAINER_NAME when several are in use at once.
# ---------------------------------------------------------------------------
AYA_DEV_IMAGE=aya-dev
AYA_DEV_IMAGE_TAG=ubuntu24.04-llvm23
AYA_DEV_CONTAINER_NAME=aya-dev

# ---------------------------------------------------------------------------
# Host paths (bind mounts)
#
# AYA_DEV_WORKSPACE_HOST is the host side of the source bind mount; the default
# "." means this directory. Prefer a path on the WSL2 ext4 filesystem
# (e.g. ~/src/eBPF) over /mnt/c or /mnt/d: mounts over the Windows 9p/drvfs
# bridge are much slower and have weaker inotify semantics.
#
# AYA_DEV_WORKDIR is the mount target and the container working directory.
# Keep it equal to the Dockerfile's WORKDIR (/workspace) if the image is also
# used with plain `docker run`, where compose does not apply working_dir.
#
# AYA_DEV_DEBUGFS_HOST must exist on the host and have debugfs mounted; WSL2
# exposes only part of debugfs but bpftool and eBPF inspection still need it.
# ---------------------------------------------------------------------------
AYA_DEV_WORKSPACE_HOST=.
AYA_DEV_WORKDIR=/workspace
AYA_DEV_DEBUGFS_HOST=/sys/kernel/debug

# ---------------------------------------------------------------------------
# Privilege posture and resource limits (host kernel / runtime specific)
#
# AYA_DEV_NETWORK_MODE=host attaches the XDP/TC program directly to the host
# interfaces. With Docker Engine inside WSL2 that is the WSL2 network namespace;
# with Docker Desktop it is the Docker Desktop VM's namespace. Set it to bridge
# where host networking is unavailable, then add explicit `ports:` to
# docker-compose.yml.
#
# AYA_DEV_PRIVILEGED=true is needed for the first validation stage; see the
# cap_add alternative documented in docker-compose.yml. When not privileged,
# keep AYA_DEV_SECCOMP_PROFILE=unconfined so bpf()/perf_event_open() are not
# blocked.
#
# AYA_DEV_MEMLOCK_SOFT/HARD=-1 means unlimited, which avoids Aya's
# "cannot allocate memory" map-creation failures on kernels that account BPF
# memory against RLIMIT_MEMLOCK. Set finite values only if the runtime rejects
# negative limits.
# ---------------------------------------------------------------------------
AYA_DEV_NETWORK_MODE=host
AYA_DEV_PRIVILEGED=true
AYA_DEV_SECCOMP_PROFILE=unconfined
AYA_DEV_MEMLOCK_SOFT=-1
AYA_DEV_MEMLOCK_HARD=-1

# ---------------------------------------------------------------------------
# Personal development preferences
# ---------------------------------------------------------------------------
AYA_DEV_RUST_BACKTRACE=1
AYA_DEV_CARGO_TERM_COLOR=always
